{
  "name": "ielts-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.node.json",
    "dev": "vite",
    "dev:staging": "vite --mode staging",
    "build": "npm run typecheck && vite build",
    "build:staging": "npm run typecheck && vite build --mode staging",
    "preview": "vite preview",
    "preview:staging": "vite preview --mode staging"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.2",
    "element-plus": "^2.7.6",
    "pinia": "^2.1.7",
    "vue": "^3.4.31",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitejs/plugin-vue": "^5.0.5",
    "sass": "^1.77.6",
    "typescript": "5.4.5",
    "vite": "^5.3.3",
    "vue-tsc": "^2.0.26"
  }
}
